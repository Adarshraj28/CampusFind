/* ============================================================
   Fonts

   Galgotias University headlines use Gotham Narrow, loaded by
   the university site from cdnfonts.com. We reference the same
   family and fall back to Montserrat (also used by the site)
   when the font server is unreachable, so a blocked CDN can
   never change the layout.
   ============================================================ */
@font-face {
  font-family: "Gotham Narrow";
  font-style: normal;
  font-weight: 400 700;
  font-display: swap;
  src: local("Gotham Narrow"),
       local("GothamNarrow-Regular"),
       url("https://fonts.cdnfonts.com/s/18578/GothamNarrow-Regular.woff") format("woff");
}
@font-face {
  font-family: "Gotham Narrow";
  font-style: normal;
  font-weight: 700 800;
  font-display: swap;
  src: local("Gotham Narrow Bold"),
       local("GothamNarrow-Bold"),
       url("https://fonts.cdnfonts.com/s/18578/GothamNarrow-Bold.woff") format("woff");
}

/* ============================================================
   CampusFind — style.css
   Design tokens, base/reset, landing page, brand lockup,
   navbar, footer, error pages.

   Galgotias University visual identity
   Colours sampled from the live university site stylesheets:
     www.galgotiasuniversity.edu.in
       /public/frontend/assets/css/style.css
       /public/frontend/assets/css/mystyle.css
       /public/frontend/assets/css/site-inline-common.css
     --ul-primary  #BC1820  brand red (most used colour on the site)
     --ul-primary-dark #BE2727  hover state
     --ul-charcoal #202020  header / dark surface
     --ul-ink      #2A2A2A  body text
     --ul-cream    #F3F3F3  light section background
     --ul-white    #FFFFFF  surfaces
   Typography follows the same site:
     body    Poppins
     display Gotham Narrow (Montserrat as the web-safe fallback)
================================== */


/* ---------- Design tokens ---------- */
:root {
  --ul-primary: #BC1820;
  --ul-primary-dark: #BE2727;
  --ul-primary-deep: #8E1218;
  --ul-blue: #BC1820;
  --ul-blue-light: #F8E4E5;
  --ul-blue-soft: #FCF0F0;

  --ul-charcoal: #202020;
  --ul-charcoal-2: #2A2A2A;

  --ul-gold: #BC1820;
  --ul-gold-dark: #8E1218;
  --ul-gold-light: #F8E4E5;
  --ul-gold-soft: #FCF0F0;
  --ul-gold-tint: rgba(188, 24, 32, 0.10);

  --ul-emerald: #1F7A4D;
  --ul-emerald-dark: #15603A;
  --ul-emerald-soft: #E4F1E8;
  --ul-emerald-tint: rgba(31,122,77,0.12);

  --ul-rose: #BC1820;
  --ul-rose-dark: #8E1218;
  --ul-rose-soft: #FBE3E4;
  --ul-rose-tint: rgba(188,24,32,0.12);

  --ul-amber: #B8860B;
  --ul-amber-dark: #8A6508;
  --ul-amber-soft: #FDF4E0;
  --ul-amber-tint: rgba(184,134,11,0.14);

  --ul-indigo: #BC1820;
  --ul-indigo-dark: #8E1218;
  --ul-indigo-soft: #FCF0F0;
  --ul-indigo-tint: rgba(188,24,32,0.12);

  /* brand anchors */
  --ul-ink: #202020;
  --ul-cream: #F3F3F3;
  --ul-white: #FFFFFF;

  /* supporting surfaces */
  --surface: #FFFFFF;
  --surface-2: #FAFAFA;
  --surface-3: #F3F3F3;
  --surface-4: #EAEAEA;

  --text: #202020;
  --text-secondary: #4A4A4A;
  --text-muted: #707070;
  --text-light: #959595;

  --border: #E4E4E4;
  --border-strong: #CFCFCF;
  --border-ink: #BC1820;

  --success: var(--ul-emerald);
  --success-soft: var(--ul-emerald-soft);
  --success-tint: var(--ul-emerald-tint);

  --warning: var(--ul-amber);
  --warning-soft: var(--ul-amber-soft);
  --warning-tint: var(--ul-amber-tint);

  --danger: var(--ul-rose);
  --danger-soft: var(--ul-rose-soft);
  --danger-tint: var(--ul-rose-tint);

  --info: var(--ul-indigo);
  --info-soft: var(--ul-indigo-soft);
  --info-tint: var(--ul-indigo-tint);

  --violet: #BC1820;
  --violet-soft: #FCF0F0;
  --cyan: #BC1820;
  --cyan-soft: #FCF0F0;

  --radius-sm: 4px;
  --radius: 6px;
  --radius-lg: 8px;
  --radius-xl: 10px;
  --radius-pill: 999px;

  --shadow-xs: 0 1px 2px rgba(32,32,32,0.05);
  --shadow-sm: 0 1px 3px rgba(32,32,32,0.08), 0 1px 2px rgba(32,32,32,0.04);
  --shadow: 0 6px 18px rgba(32,32,32,0.08);
  --shadow-md: 0 12px 36px rgba(32,32,32,0.12);
  --shadow-lg: 0 20px 56px rgba(32,32,32,0.16);

  /* Type stack lifted from the university site */
  --font-sans: "Poppins", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  --font-display: "Gotham Narrow", "Montserrat", "Poppins", -apple-system, "Segoe UI", sans-serif;

  --nav-h: 68px;
  --sidebar-w: 264px;
  --topbar-h: 68px;
  --sidebar-open-w: 264px;
  --transition: 160ms ease;
}


/* ---------- Dark theme ---------- */
[data-theme="dark"] {
  --ul-primary: #E23A40;
  --ul-primary-dark: #C01C24;
  --ul-blue: #E23A40;
  --ul-blue-light: #3A1416;
  --ul-blue-soft: #2A1012;

  --ul-charcoal: #161616;

  --ul-gold: #E23A40;
  --ul-gold-dark: #C01C24;
  --ul-gold-light: #3A1416;
  --ul-gold-soft: #2A1012;
  --ul-gold-tint: rgba(226,58,64,0.18);

  --ul-emerald: #46B98A;
  --ul-emerald-dark: #1F7A4D;
  --ul-emerald-soft: #0E2418;
  --ul-emerald-tint: rgba(70,185,138,0.20);

  --ul-rose: #E23A40;
  --ul-rose-dark: #C01C24;
  --ul-rose-soft: #3A1416;
  --ul-rose-tint: rgba(226,58,64,0.22);

  --ul-amber: #E0A93B;
  --ul-amber-dark: #B8860B;
  --ul-amber-soft: #2E2310;
  --ul-amber-tint: rgba(224,169,59,0.20);

  --ul-indigo: #E23A40;
  --ul-indigo-dark: #C01C24;
  --ul-indigo-soft: #2A1012;
  --ul-indigo-tint: rgba(226,58,64,0.20);

  --surface: #161616;
  --surface-2: #1F1F1F;
  --surface-3: #161616;
  --surface-4: #2A2A2A;

  --text: #F3F3F3;
  --text-secondary: #D6D6D6;
  --text-muted: #A3A3A3;
  --text-light: #C7C7C7;

  --border: #333333;
  --border-strong: #454545;
  --border-ink: #E23A40;

  --shadow-xs: 0 1px 2px rgba(0,0,0,0.5);
  --shadow-sm: 0 1px 3px rgba(0,0,0,0.55);
  --shadow: 0 6px 18px rgba(0,0,0,0.5);
  --shadow-md: 0 12px 36px rgba(0,0,0,0.6);
  --shadow-lg: 0 20px 56px rgba(0,0,0,0.68);

  --ul-ink: #F3F3F3;
  --ul-cream: #121212;
  --ul-white: #121212;
}


/* ---------- Reset ---------- */
*, *::before, *::after { box-sizing: border-box; }
* { margin: 0; }

html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }

body {
  font-family: var(--font-sans);
  font-size: 15px;
  line-height: 1.6;
  color: var(--text);
  background: var(--ul-cream);
  -webkit-font-smoothing: antialiased;
  min-height: 100vh;
}

img, picture, svg, canvas { display: block; max-width: 100%; }

input, button, textarea, select { font: inherit; color: inherit; }

button { cursor: pointer; background: none; border: none; }

h1, h2, h3, h4, h5 {
  font-family: var(--font-display);
  line-height: 1.25;
  color: var(--text);
  font-weight: 700;
  letter-spacing: -0.01em;
}

p { color: var(--text-secondary); }

a { color: var(--ul-primary); text-decoration: none; transition: color var(--transition), border-color var(--transition); }
a:hover { color: var(--ul-primary-dark); }
a:focus-visible {
  outline: 3px solid rgba(188,24,32,0.45);
  outline-offset: 2px;
  border-radius: 4px;
}

ul, ol { padding: 0; list-style: none; }

hr { border: none; border-top: 1px solid var(--border); margin: 24px 0; }

::selection { background: var(--ul-blue-light); color: var(--ul-primary-dark); }

:focus-visible {
  outline: 3px solid rgba(188,24,32,0.45);
  outline-offset: 2px;
  border-radius: 4px;
}

[data-theme="dark"] :focus-visible { outline-color: rgba(215,36,55,0.6); }


/* ---------- Utility ---------- */
/* Site-wide full-width layout: every section bleeds to the viewport edges
   and uses a single constrained content band, matching the university site's
   pattern (full-bleed background + centred content column). */
.container {
  width: 100%;
  max-width: 1240px;
  margin-inline: auto;
  padding-inline: 28px;
}

/* Full-bleed section: background, border, padding all span the viewport.
   Use on .section elements that should not be centred inside a narrower
   container (landing page full-width sections). */
.full-bleed {
  width: 100vw;
  max-width: 100%;
  padding: 0;
  margin: 0 calc(-50vw + 50%);
  box-sizing: border-box;
}

/* Soft full-bleed: keeps the internal vertical padding but drops the
   horizontal margins the .container would add, so the section still spans
   the full viewport width while the content inside stays centred. */
.full-bleed--soft {
  width: 100vw;
  max-width: 100%;
  margin: 0 calc(-50vw + 50%);
  padding-inline: 0;
  box-sizing: border-box;
}

.visually-hidden {
  position: absolute !important;
  width: 1px; height: 1px;
  padding: 0; margin: -1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}

.skip-link {
  position: absolute;
  top: -60px;
  left: 16px;
  z-index: 999;
  background: var(--ul-primary);
  color: #fff;
  padding: 10px 18px;
  border-radius: 0 0 var(--radius) var(--radius);
  font-weight: 700;
  border-left: 4px solid var(--ul-primary);
  transition: top var(--transition);
}
.skip-link:focus { top: 0; color: #fff; }

.text-muted { color: var(--text-secondary); }
.text-center { text-align: center; }
.mt-0 { margin-top: 0; }
.hidden { display: none !important; }

/* ---------- Section eyebrow ---------- */
.section-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 12.5px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #fff;
  background: var(--ul-primary);
  border: 1px solid color-mix(in srgb, var(--ul-primary) 45%, transparent);
  padding: 6px 14px;
  border-radius: var(--radius-pill);
}
.section-eyebrow .s-dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--ul-primary); display: inline-block;
}

.section-eyebrow.emerald { color: #fff; background: var(--ul-emerald); border-color: color-mix(in srgb, var(--ul-emerald) 50%, transparent); }
.section-eyebrow.amber  { color: #fff; background: var(--ul-amber);  border-color: color-mix(in srgb, var(--ul-amber) 50%, transparent); }
.section-eyebrow.rose   { color: #fff; background: var(--ul-rose);   border-color: color-mix(in srgb, var(--ul-rose) 50%, transparent); }
.section-eyebrow.indigo { color: #fff; background: var(--ul-indigo); border-color: color-mix(in srgb, var(--ul-indigo) 50%, transparent); }


/* ---------- Logo / brand lockup ---------- */
.logo {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-family: var(--font-display);
  font-weight: 800;
  font-size: 19px;
  color: var(--text);
  letter-spacing: -0.02em;
}
.logo:hover { color: var(--text); }

.logo-mark {
  width: 40px; height: 40px; flex: 0 0 40px;
  border-radius: 8px;
  background: #FFFFFF;
  display: grid; place-items: center;
  box-shadow: 0 1px 3px rgba(32,32,32,0.14);
  border: 1px solid var(--border-strong);
  overflow: hidden;
}
.logo-mark img { width: 100%; height: 100%; object-fit: contain; }

.logo-text span { color: var(--ul-primary); }

/* Brand lockup — used anywhere the app is branded as the university. */
.brand-lockup {
  display: inline-flex;
  align-items: center;
  gap: 11px;
  text-decoration: none;
  padding: 8px 16px 8px 8px;
  border-radius: 10px;
  border: 1px solid var(--border);
  background: var(--surface);
}
.brand-lockup:focus-visible { outline: 3px solid rgba(188,24,32,0.55); outline-offset: 2px; border-radius: 10px; }

.brand-cf {
  font-family: var(--font-display);
  font-weight: 800;
  font-size: 18px;
  letter-spacing: -0.03em;
  color: var(--text);
  line-height: 1.15;
  display: block;
}
.brand-cf span { color: var(--ul-primary); }

.brand-gu {
  display: inline-block;
  padding: 3px 10px;
  border-radius: 999px;
  background: var(--ul-primary);
  color: #FFFFFF;
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  border: 1px solid color-mix(in srgb, var(--ul-primary-deep) 60%, transparent);
  box-shadow: 0 2px 8px color-mix(in srgb, var(--ul-primary) 22%, transparent);
  text-decoration: none;
}
.brand-txt { display: inline-flex; flex-direction: column; align-items: flex-start; gap: 4px; }
.brand-mark {
  width: 38px; height: 38px; flex: 0 0 38px;
  border-radius: 8px;
  background: #FFFFFF;
  border: 1px solid var(--border-strong);
  display: grid; place-items: center;
  overflow: hidden;
  box-shadow: 0 1px 2px rgba(32,32,32,0.10);
}
.brand-mark img { width: 100%; height: 100%; object-fit: contain; }

.brand-foot {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--text-muted);
  font-size: 12.5px;
  font-weight: 500;
}
.brand-foot a { color: var(--ul-primary); text-decoration: none; }
.brand-foot a:hover { color: var(--ul-primary-dark); text-decoration: underline; }
.brand-foot svg { width: 13px; height: 13px; }


/* ---------- Buttons ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-weight: 600;
  font-size: 14.5px;
  line-height: 1;
  padding: 12px 20px;
  border-radius: var(--radius);
  border: 1px solid transparent;
  white-space: nowrap;
  transition: background var(--transition), border-color var(--transition),
              color var(--transition), transform var(--transition), box-shadow var(--transition);
  user-select: none;
}
.btn:active { transform: translateY(1px); }
.btn:disabled, .btn[aria-disabled="true"] { opacity: 0.6; cursor: not-allowed; transform: none; }
.btn svg { width: 17px; height: 17px; flex: 0 0 auto; }

.btn-primary { background: var(--ul-primary); color: #fff; box-shadow: var(--shadow-xs); border: 1px solid color-mix(in srgb, var(--ul-primary) 35%, transparent); }
.btn-primary:hover:not(:disabled) { background: var(--ul-primary-dark); color: #fff; box-shadow: var(--shadow); border-color: var(--ul-primary-dark); }

.btn-secondary { background: var(--surface); color: var(--text); border-color: var(--border-strong); }
.btn-secondary:hover:not(:disabled) { background: var(--surface-2); color: var(--text); border-color: var(--text-muted); }

.btn-ghost { background: transparent; color: var(--text-secondary); }
.btn-ghost:hover:not(:disabled) { background: var(--surface-2); color: var(--text); }

.btn-soft { background: var(--ul-blue-soft); color: var(--ul-primary-deep); }
.btn-soft:hover:not(:disabled) { background: var(--ul-blue-light); color: var(--ul-primary-deep); }

.btn-danger { background: var(--ul-rose); color: #fff; }
.btn-danger:hover:not(:disabled) { background: var(--ul-rose-dark); color: #fff; }

.btn-success { background: var(--ul-emerald); color: #fff; }
.btn-success:hover:not(:disabled) { background: var(--ul-emerald-dark); color: #fff; }

.btn-warning { background: var(--ul-amber); color: #1A1A1A; }
.btn-warning:hover:not(:disabled) { background: var(--ul-amber-dark); color: #1A1A1A; }

.btn-sm { padding: 8px 14px; font-size: 13.5px; border-radius: 10px; }
.btn-sm svg { width: 15px; height: 15px; }
.btn-lg { padding: 15px 26px; font-size: 15.5px; }
.btn-block { width: 100%; }

.btn-icon {
  width: 42px; height: 42px;
  padding: 0;
  border-radius: 12px;
  display: inline-grid;
  place-items: center;
  color: var(--text-secondary);
  background: transparent;
  border: 1px solid transparent;
}
.btn-icon:hover { background: var(--surface-2); color: var(--text); }
.btn-icon svg { width: 19px; height: 19px; }
.btn-icon.is-active { background: var(--ul-blue-soft); color: var(--ul-blue); }


/* ---------- Public navbar ---------- */
.site-nav {
  position: sticky;
  top: 0;
  z-index: 60;
  background: color-mix(in srgb, var(--surface) 92%, transparent);
  backdrop-filter: saturate(180%) blur(12px);
  border-bottom: 1px solid var(--border);
  box-shadow: 0 1px 0 color-mix(in srgb, var(--ul-primary) 25%, transparent);
}
.site-nav-inner {
  height: var(--nav-h);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}
/* The navbar logo sits between the brand and the link list, so the
   three groups need to stay balanced rather than evenly spread. */
.site-nav-inner > .logo { margin-right: auto; }
.site-nav-inner .site-nav-links { margin-right: auto; }
.site-nav-inner .logo + .site-nav-links { margin-left: 18px; }
.site-nav-links {
  display: flex;
  align-items: center;
  gap: 4px;
}
.site-nav-links a {
  padding: 9px 14px;
  border-radius: 10px;
  font-size: 14.5px;
  font-weight: 500;
  color: var(--text-secondary);
  transition: background var(--transition), color var(--transition);
}
.site-nav-links a:hover, .site-nav-links a[aria-current="page"] {
  background: var(--ul-blue-soft);
  color: var(--ul-primary);
  border-bottom: 2px solid var(--ul-primary);
}
.site-nav-actions { display: flex; align-items: center; gap: 10px; }

.nav-toggle { display: none; }
.nav-toggle svg { width: 20px; height: 20px; }

.mobile-menu {
  display: none;
  border-top: 1px solid var(--border);
  background: var(--surface);
  padding: 12px 24px 20px;
}
.mobile-menu > .logo { margin-bottom: 14px; }
.mobile-menu.is-open { display: block; }
.mobile-menu a {
  display: block;
  padding: 13px 8px;
  font-weight: 500;
  color: var(--text);
  border-bottom: 1px solid var(--border);
}
.mobile-menu a:last-of-type { border-bottom: none; }
.mobile-menu .btn { margin-top: 12px; }


/* ---------- Landing hero ---------- */
.hero {
  position: relative;
  overflow: hidden;
  padding: 84px 0 72px;
  background:
    radial-gradient(900px 460px at 8% -12%, rgba(188,24,32,0.16), transparent 64%),
    radial-gradient(820px 420px at 96% 6%,  rgba(32,32,32,0.10), transparent 60%),
    radial-gradient(620px 360px at 78% 96%,  rgba(188,24,32,0.08), transparent 64%),
    var(--ul-cream);
}
.hero-grid {
  display: grid;
  grid-template-columns: 1.05fr 0.95fr;
  gap: 56px;
  align-items: center;
  width: 100%;
  max-width: 1240px;
  margin: 0 auto;
  padding-inline: 28px;
}
.hero h1 {
  font-size: clamp(38px, 5.6vw, 62px);
  font-weight: 800;
  letter-spacing: -0.035em;
  line-height: 1.04;
  margin: 22px 0 18px;
}
.hero h1 .accent { color: var(--ul-primary); position: relative; white-space: nowrap; }
.hero h1 .accent::after {
  content: "";
  position: absolute;
  left: 0; right: 0; bottom: 4px;
  height: 10px;
  background: linear-gradient(90deg, rgba(188,24,32,0.26), rgba(188,24,32,0.06));
  border-radius: 3px;
  z-index: -1;
}
.hero-lead { font-size: 17.5px; max-width: 54ch; }
.hero-lead strong { color: var(--ul-ink); font-weight: 600; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 30px; }

/* ---------- Hero: university affiliation ---------- */
.hero-university {
  display: inline-flex;
  align-items: center;
  gap: 11px;
  text-decoration: none;
  padding: 6px 16px 6px 6px;
  border-radius: 999px;
  background: var(--surface);
  border: 1px solid var(--border);
  box-shadow: var(--shadow-xs);
  transition: border-color var(--transition), box-shadow var(--transition);
}
.hero-university:hover { border-color: var(--border-strong); box-shadow: var(--shadow-sm); }
.hero-university:focus-visible { outline: 3px solid rgba(188,24,32,0.45); outline-offset: 2px; }
.hero-university-mark {
  width: 34px; height: 34px; flex: 0 0 34px;
  border-radius: 8px;
  background: #FFFFFF;
  border: 1px solid var(--border);
  display: grid; place-items: center;
  overflow: hidden;
}
.hero-university-mark img { width: 100%; height: 100%; object-fit: contain; }
.hero-university-txt { display: flex; flex-direction: column; line-height: 1.25; }
.hero-university-txt b {
  font-family: var(--font-display);
  font-size: 15px;
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--ul-ink);
}
.hero-university-txt span { font-size: 11.5px; color: var(--text-muted); }

/* ---------- Hero: inline search ---------- */
.hero-search {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 26px;
  padding: 7px 7px 7px 16px;
  background: var(--surface);
  border: 1px solid var(--border-strong);
  border-radius: 999px;
  box-shadow: var(--shadow);
  transition: border-color var(--transition), box-shadow var(--transition);
  max-width: 560px;
}
.hero-search:focus-within {
  border-color: var(--ul-primary);
  box-shadow: var(--shadow), 0 0 0 4px rgba(188,24,32,0.12);
}
.hero-search > svg { width: 20px; height: 20px; color: var(--text-muted); flex: 0 0 20px; }
.hero-search input {
  flex: 1;
  min-width: 0;
  border: none;
  background: none;
  font-size: 15px;
  padding: 8px 0;
  color: var(--text);
}
.hero-search input:focus { outline: none; }
.hero-search input::placeholder { color: var(--text-muted); }
.hero-search .btn { border-radius: 999px; flex: 0 0 auto; }

.hero-search-hint {
  font-size: 13px;
  color: var(--text-muted);
  margin-top: 10px;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
}
.link-chip {
  font: inherit;
  color: var(--ul-primary);
  background: none;
  border: none;
  padding: 0;
  text-decoration: underline;
  text-underline-offset: 2px;
  cursor: pointer;
}
.link-chip:hover { color: var(--ul-primary-dark); }
.link-chip:focus-visible { outline: 2px solid rgba(188,24,32,0.45); outline-offset: 2px; border-radius: 3px; }

/* ---------- Hero: live item panel ---------- */
.hero-visual { position: relative; }
.hero-panel {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  overflow: hidden;
}
.hero-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 16px 18px;
  border-bottom: 1px solid var(--border);
  background: var(--surface-2);
}
.hero-panel-head b { display: block; font-size: 14.5px; color: var(--ul-ink); }
.hero-panel-head span { font-size: 12.5px; color: var(--text-muted); }
.hero-items { display: flex; flex-direction: column; }
.hero-items-loading { padding: 28px 18px; font-size: 13.5px; color: var(--text-muted); text-align: center; }
.hero-item {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 14px 18px;
  border-bottom: 1px solid var(--border);
  text-decoration: none;
  color: inherit;
  transition: background var(--transition);
}
.hero-item:last-child { border-bottom: none; }
.hero-item:hover { background: var(--surface-2); }
.hero-item:focus-visible { outline: 3px solid rgba(188,24,32,0.45); outline-offset: -3px; }
.hero-item-thumb {
  width: 62px; height: 62px; flex: 0 0 62px;
  border-radius: 8px;
  overflow: hidden;
  background: var(--surface-3);
  border: 1px solid var(--border);
}
.hero-item-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
.hero-item-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.hero-item-body b {
  font-size: 14.5px;
  color: var(--ul-ink);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.hero-item-body span {
  display: flex; align-items: center; gap: 5px;
  font-size: 12.5px; color: var(--text-secondary);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.hero-item-body span svg { width: 13px; height: 13px; flex: 0 0 13px; color: var(--text-muted); }
.hero-item-when { color: var(--text-muted) !important; font-size: 11.5px !important; }
.hero-item-id {
  flex: 0 0 auto;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 11.5px;
  color: var(--text-muted);
  background: var(--surface-3);
  border: 1px solid var(--border);
  padding: 3px 8px;
  border-radius: 999px;
}
.hero-panel-foot {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  padding: 13px 18px;
  font-size: 13.5px;
  font-weight: 600;
  color: var(--ul-primary);
  background: var(--surface-2);
  border-top: 1px solid var(--border);
  text-decoration: none;
}
.hero-panel-foot:hover { background: var(--surface-3); color: var(--ul-primary-dark); }
.hero-panel-foot svg { width: 15px; height: 15px; }

@media (max-width: 900px) {
  .hero-search { max-width: none; }
  .hero-search .btn span { display: none; }
}
@media (max-width: 560px) {
  .hero-search { border-radius: var(--radius-lg); }
  .hero-search .btn { padding: 12px 16px; }
}
.hero-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 22px;
  margin-top: 34px;
  padding-top: 24px;
  border-top: 1px solid var(--border);
}
.hero-meta-item { display: flex; align-items: center; gap: 9px; font-size: 13.5px; color: var(--text-secondary); font-weight: 500; }
.hero-meta-item svg { width: 17px; height: 17px; }
.hero-meta-item.primary  svg { color: var(--ul-primary); }
.hero-meta-item.emerald svg { color: var(--ul-emerald); }
.hero-meta-item.amber   svg { color: var(--ul-amber); }
.hero-meta-item.rose    svg { color: var(--ul-rose); }
.hero-meta-item.indigo  svg { color: var(--ul-primary-deep); }


/* ---------- Sections ---------- */
.section { padding: 76px 0; }
.section-alt { background: var(--surface); border-block: 1px solid var(--border); }

/* Full-width section variants --- the university site runs full-bleed
   bands, so every section on this site should do the same instead of
   sitting inside a centred 1200px box. */
.section-full { padding: 96px 0; }
.section-full:first-child { padding-top: 80px; }
.section-full:last-child { padding-bottom: 80px; }

/* Centred content band inside a full-bleed section: keeps the vertical
   rhythm of .section but does not centre the section itself. */
.section-full .container { width: 100%; max-width: 1240px; padding-inline: 28px; margin: 0 auto; }
.section-head { max-width: 680px; margin: 0 auto 46px; text-align: center; }
.section-head h2 { font-size: clamp(26px, 3.4vw, 36px); font-weight: 800; margin: 16px 0 12px; letter-spacing: -0.025em; }
.section-head p { font-size: 16.5px; }

.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
.grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }

.feature-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 26px;
  transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
}
.section-alt .feature-card { background: var(--ul-cream); }
.feature-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); border-color: var(--ul-blue-light); }
.feature-card .feat-ico {
  width: 46px; height: 46px;
  border-radius: 12px;
  display: grid; place-items: center;
  background: linear-gradient(135deg, var(--ul-blue-soft), var(--ul-indigo-soft));
  color: var(--ul-blue);
  margin-bottom: 18px;
  border: 1px solid color-mix(in srgb, var(--ul-blue) 22%, transparent);
}
.feature-card .feat-ico svg { width: 22px; height: 22px; }
.feature-card h3 { font-size: 17.5px; margin-bottom: 8px; }
.feature-card p { font-size: 14.5px; }

.feature-card.accents--emerald .feat-ico { color: var(--ul-emerald); background: linear-gradient(135deg, var(--ul-emerald-soft), var(--ul-blue-soft)); }
.feature-card.accents--amber  .feat-ico { color: var(--ul-amber); background: linear-gradient(135deg, var(--ul-amber-soft), var(--ul-blue-soft)); }
.feature-card.accents--rose   .feat-ico { color: var(--ul-rose); background: linear-gradient(135deg, var(--ul-rose-soft), var(--ul-blue-soft)); }
.feature-card.accents--indigo .feat-ico { color: var(--ul-indigo); background: linear-gradient(135deg, var(--ul-indigo-soft), var(--ul-blue-soft)); }

.steps-row { display: grid; grid-template-columns: repeat(5, 1fr); gap: 18px; counter-reset: step; }
.how-step { position: relative; text-align: center; padding: 0 6px; }
.how-step .num {
  width: 46px; height: 46px;
  margin: 0 auto 14px;
  border-radius: 50%;
  background: var(--surface);
  border: 2px solid var(--ul-primary);
  color: var(--ul-primary);
  display: grid; place-items: center;
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 16px;
}
.section-alt .how-step .num { background: var(--ul-blue-light); }
.how-step.current .num, .how-step.active .num {
  border-color: var(--ul-primary);
  background: var(--ul-primary);
  color: #fff;
}
.how-step h3 { font-size: 15.5px; margin-bottom: 6px; }
.how-step p { font-size: 13.5px; }
.how-step::after {
  content: "";
  position: absolute;
  top: 23px; left: calc(50% + 32px);
  width: calc(100% - 64px);
  border-top: 2px dashed var(--border-strong);
}
.how-step:last-child::after { display: none; }

.stats-band {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  background: linear-gradient(135deg, var(--ul-primary) 0%, var(--ul-primary-deep) 100%);
  border-radius: var(--radius-xl);
  padding: 42px 36px;
  color: #fff;
  box-shadow: var(--shadow-lg), 0 0 0 1px color-mix(in srgb, var(--ul-primary) 40%, transparent);
}
.stat-block { text-align: center; }
.stat-block b { display: block; font-family: var(--font-display); font-size: clamp(26px, 3vw, 36px); font-weight: 800; letter-spacing: -0.02em; }
.stat-block span { font-size: 13.5px; opacity: 0.85; }

.cta-band {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-xl);
  padding: 50px 40px;
  text-align: center;
  box-shadow: var(--shadow-sm);
  background: linear-gradient(180deg, var(--surface) 0%, var(--ul-blue-light) 100%);
  border-top: 4px solid var(--ul-primary);
}
.cta-band h2 { font-size: clamp(24px, 3vw, 32px); font-weight: 800; margin-bottom: 12px; }
.cta-band p { max-width: 56ch; margin: 0 auto 26px; font-size: 16px; }
.cta-actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

/* Full-width CTA band: full-bleed behind a centred card. */
.cta-band-full {
  width: 100vw;
  max-width: 100%;
  margin: 0 calc(-50vw + 50%);
  padding: 64px 0;
  box-sizing: border-box;
  background: linear-gradient(180deg, var(--surface) 0%, var(--ul-blue-light) 100%);
  border-top: 4px solid var(--ul-primary);
}
.cta-band-full .container { width: 100%; max-width: 1240px; padding-inline: 28px; margin: 0 auto; }

.about-rail {
  padding-top: 0;
  padding-bottom: 0;
}
.about-rail__inner {
  display: grid;
  grid-template-columns: 1fr 380px;
  gap: 48px;
  align-items: start;
  width: 100%;
  max-width: 1240px;
  margin: 0 auto;
  padding-inline: 28px;
  padding-top: 40px;
  padding-bottom: 40px;
}
.about-rail__copy {
  max-width: 720px;
}
.about-rail__copy .section-eyebrow {
  align-items: flex-start;
  padding: 7px 15px;
  gap: 9px;
  font-size: 12px;
}
.about-rail__copy .section-eyebrow svg {
  width: 15px; height: 15px;
  flex: 0 0 15px;
}
.about-rail__copy h2 {
  font-size: clamp(28px, 3.6vw, 42px);
  letter-spacing: -0.03em;
  margin: 16px 0 14px;
}
.about-rail__copy p {
  font-size: 16.5px;
  line-height: 1.8;
  color: var(--text-secondary);
  margin: 0 0 20px;
}
.about-list li b {
  display: block;
  font-size: 15.5px;
  letter-spacing: -0.01em;
}
.about-list li span {
  display: block;
  font-size: 14px;
  color: var(--text-secondary);
}
.about-list li span b {
  color: var(--text);
  font-weight: 600;
}

.about-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-top: 24px;
}
.about-stat {
  background: var(--ul-cream);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 20px 22px;
  text-align: center;
  transition: border-color var(--transition), box-shadow var(--transition);
}
.about-stat:hover {
  border-color: var(--ul-primary);
  box-shadow: var(--shadow-sm);
}
.about-stat .as-num {
  font-family: var(--font-display);
  font-size: clamp(28px, 3vw, 42px);
  font-weight: 800;
  color: var(--ul-primary);
  letter-spacing: -0.02em;
  line-height: 1;
}
.about-stat .as-label {
  font-size: 13px;
  color: var(--text-secondary);
  margin-top: 6px;
  line-height: 1.4;
}

.about-cta {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 28px;
  padding-top: 22px;
  border-top: 1px solid var(--border);
}
.about-cta .btn {
  display: inline-flex;
  align-items: center;
  gap: 9px;
}

/* Quick links — narrow vertical rail, left-aligned */
.about-rail__panel {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 24px 26px;
  box-shadow: var(--shadow-sm);
  border-left: 4px solid var(--ul-primary);
}
.about-rail__panel h3 {
  font-size: 17px;
  margin-bottom: 14px;
  color: var(--ul-ink);
  font-family: var(--font-display);
}
.quick-links {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.quick-link {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 11px 14px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--surface);
  text-decoration: none;
  color: var(--text);
  transition: border-color var(--transition), box-shadow var(--transition), background var(--transition), transform var(--transition);
}
.quick-link:hover {
  border-color: var(--ul-primary);
  box-shadow: var(--shadow-sm);
  transform: translateX(3px);
}
.quick-link svg {
  width: 18px; height: 18px;
  color: var(--ul-primary);
  flex: 0 0 18px;
}
.quick-link span { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.quick-link b {
  font-size: 14.5px;
  font-weight: 700;
  color: var(--text);
}
.quick-link .text-xs {
  font-size: 11.5px;
  color: var(--text-muted);
}
.ql-arrow {
  flex: 0 0 auto;
  color: var(--text-muted);
  transition: color var(--transition), transform var(--transition);
}
.quick-link:hover .ql-arrow { color: var(--ul-primary); transform: translateX(5px); }


/* ---------- Footer ---------- */
.site-footer {
  background: var(--surface);
  border-top: 1px solid var(--border);
  padding: 52px 0 28px;
  margin-top: 40px;
}
.footer-grid {
  display: grid;
  grid-template-columns: 1.6fr 1fr 1fr 1fr;
  gap: 36px;
  padding-bottom: 34px;
  border-bottom: 1px solid var(--border);
}
.footer-brand p { font-size: 14px; margin-top: 14px; max-width: 34ch; }
.footer-lockup { margin-top: 16px; }
.footer-col h4 { font-size: 13px; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-muted); margin-bottom: 14px; font-weight: 700; }
.footer-col a { display: block; padding: 6px 0; font-size: 14.5px; color: var(--text-secondary); }
.footer-col a:hover { color: var(--ul-primary); }
.footer-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
  padding-top: 22px;
  font-size: 13.5px;
  color: var(--text-muted);
}
.footer-note {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  background: var(--ul-blue-soft);
  color: var(--ul-primary-deep);
  border: 1px solid color-mix(in srgb, var(--ul-primary) 40%, transparent);
  padding: 5px 12px;
  border-radius: var(--radius-pill);
  font-size: 12.5px;
  font-weight: 700;
  letter-spacing: 0.02em;
}
.footer-note svg { width: 14px; height: 14px; }


/* ---------- Error pages ---------- */
.error-page {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 40px 24px;
  text-align: center;
  background:
    radial-gradient(700px 360px at 50% -10%, rgba(188,24,32,0.16), transparent 65%),
    radial-gradient(520px 360px at 14% 96%,  rgba(32,32,32,0.14), transparent 64%),
    var(--ul-cream);
}
.error-code {
  font-family: var(--font-display);
  font-size: clamp(76px, 16vw, 132px);
  font-weight: 800;
  line-height: 1;
  letter-spacing: -0.05em;
  background: linear-gradient(135deg, var(--ul-primary), var(--ul-primary-deep));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.error-page h1 { font-size: clamp(22px, 3vw, 30px); margin: 16px 0 10px; }
.error-page p { max-width: 48ch; margin: 0 auto 26px; font-size: 16px; }
.error-actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
.error-icon {
  width: 64px; height: 64px;
  margin: 0 auto 6px;
  border-radius: 50%;
  display: grid; place-items: center;
  background: var(--ul-blue-soft);
  color: var(--ul-primary-deep);
  border: 1px solid color-mix(in srgb, var(--ul-primary) 50%, transparent);
}
.error-icon svg { width: 30px; height: 30px; }
