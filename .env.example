# ============================================================
# CampusFind — environment configuration
# Copy this file to `.env` and fill in the values, OR paste
# the two values into js/config.js. Never commit real keys
# for a service other than the public anon key.
# ============================================================

# Project URL — Supabase dashboard → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Public anon key (safe to ship; RLS protects the data)
SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# Storage bucket for item photos (create it once in the dashboard)
SUPABASE_PHOTOS_BUCKET=campusfind-photos

# auto | local | supabase
#   auto     - use Supabase when configured, otherwise localStorage
#   local    - always localStorage (review builds, offline demos)
#   supabase - require Supabase; the app refuses to boot without it
CAMPUSFIND_MODE=auto